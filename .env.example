# Claude Sonnet is used for requirement analysis and PRD reasoning.
# To use the shared Qwen server instead (OpenAI-compatible, zrok Basic auth):
#   LLM_PROVIDER=openai_compat
#   LLM_MODEL=qwen3.8:27b
#   LLM_BASE_URL=https://qwen-intern-721fb0.shares.zrok.io/v1
#   ZROK_BASIC_AUTH=intern:<password>
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0
ANTHROPIC_API_KEY=your_api_key_here
RAG_MCP_URL=http://localhost:8080/sse
# Target RAG knowledge base name ("finance" or "recruit"); --rag-kb overrides this,
# and the CLI also defaults to "recruit" automatically when --metadata-source recruit.
RAG_KNOWLEDGE_BASE=finance
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
RAG_MAX_CONTEXT_CHARS=12000
RAG_CONNECT_TIMEOUT=20
RAG_READ_TIMEOUT=300

# Paste your Zoho Analytics OAuth values in the local .env file.
# Do not commit .env or share these values in chat.
ANALYTICS_CLIENT_ID=your_client_id_here
ANALYTICS_CLIENT_SECRET=your_client_secret_here
ANALYTICS_REFRESH_TOKEN=your_refresh_token_here
ANALYTICS_ORG_ID=your_analytics_org_id_here
# Request this scope when creating the Zoho authorization code.
# ZohoAnalytics.metadata.read
# Optional: use this instead of a refresh token while testing one session.
ANALYTICS_ACCESS_TOKEN=
# India data center example. Use the server URI for the account's data center.
ACCOUNTS_SERVER_URL=https://accounts.zoho.in
ANALYTICS_SERVER_URL=https://analyticsapi.zoho.in

# Zoho Recruit OAuth and API settings (for Recruit, separate from Analytics).
ZOHO_RECRUIT_CLIENT_ID=your_recruit_client_id_here
ZOHO_RECRUIT_CLIENT_SECRET=your_recruit_client_secret_here
ZOHO_RECRUIT_REFRESH_TOKEN=your_recruit_refresh_token_here
# Set this only if required by the OAuth client type; it must exactly match
# the redirect URI registered in the Zoho API Console.
ZOHO_RECRUIT_REDIRECT_URI=
# EU data center. Use the matching domains for your Zoho account.
ZOHO_RECRUIT_ACCOUNTS_URL=https://accounts.zoho.eu
ZOHO_RECRUIT_API_URL=https://recruit.zoho.eu/recruit/v2
